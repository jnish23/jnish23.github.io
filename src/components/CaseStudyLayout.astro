---
import BaseLayout from '@layouts/BaseLayout.astro';

interface Props {
  title: string;
  subtitle: string;
  category: string;
  tools: string[];
  duration?: string;
  ogDescription?: string;
}

const { title, subtitle, category, tools, duration, ogDescription } = Astro.props;
---

<BaseLayout
  title={`${title} | Jordan Nishimura`}
  description={ogDescription ?? subtitle}
  ogTitle={`${title} | Jordan Nishimura`}
  ogDescription={ogDescription ?? subtitle}
>
  <!-- Back link -->
  <div class="max-w-4xl mx-auto px-6 pt-12 pb-0">
    <a
      href="/projects"
      class="inline-flex items-center gap-2 font-mono text-xs text-white/35 hover:text-[#2DD4BF] transition-colors duration-200 tracking-wide"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
      </svg>
      All Projects
    </a>
  </div>

  <!-- Case study header -->
  <header class="max-w-4xl mx-auto px-6 pt-10 pb-12 border-b border-white/10">
    <p class="font-mono text-[#2DD4BF] text-xs tracking-widest uppercase mb-5">{category}</p>
    <h1 class="font-display text-4xl md:text-6xl text-white leading-tight mb-4">{title}</h1>
    <p class="font-sans text-white/55 text-lg leading-relaxed max-w-2xl mb-8">{subtitle}</p>

    <div class="flex flex-wrap items-center gap-6">
      <!-- Tool badges -->
      <div class="flex flex-wrap gap-2">
        {tools.map((tool) => (
          <span class="font-mono text-xs text-white/50 bg-white/5 border border-white/10 px-2.5 py-1 rounded">
            {tool}
          </span>
        ))}
      </div>
      {duration && (
        <span class="font-mono text-xs text-white/25 tracking-wide">{duration}</span>
      )}
    </div>
  </header>

  <!-- Case study body -->
  <article class="max-w-4xl mx-auto px-6 py-16 space-y-16">
    <slot />
  </article>
</BaseLayout>

<style is:global>
  /* Section headings inside case studies */
  .cs-section-label {
    @apply font-mono text-[#2DD4BF] text-xs tracking-widest uppercase mb-3;
  }
  .cs-section-title {
    @apply font-display text-2xl text-white mb-5 leading-snug;
  }
  .cs-prose {
    @apply font-sans text-white/65 text-base leading-relaxed space-y-4;
  }

  /* Code blocks */
  .cs-code {
    @apply font-mono text-sm text-white/75 bg-white/[0.04] border border-white/10 border-l-2 border-l-[#2DD4BF]/50 rounded-r p-5 overflow-x-auto leading-relaxed my-6;
  }

  /* Inline code */
  .cs-code-inline {
    @apply font-mono text-xs text-[#2DD4BF]/80 bg-white/5 px-1.5 py-0.5 rounded;
  }

  /* Divider between sections */
  .cs-divider {
    @apply border-white/10;
  }
</style>
