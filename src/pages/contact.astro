---
import BaseLayout from '@layouts/BaseLayout.astro';

// TODO: Create a free account at formspree.io, create a form,
// and replace the placeholder below with your Formspree endpoint URL.
// Example: https://formspree.io/f/abcdefgh
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/mvzwzldn';

const links = [
  {
    label: 'GitHub',
    href: 'https://github.com/jnish23',
    description: 'Projects, code, and repos',
    icon: `<svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>`,
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/jordan-nishimura/',
    description: 'Professional profile',
    icon: `<svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];
---

<BaseLayout
  title="Contact | Jordan Nishimura"
  description="Interested in working together? Get in touch with me!"
>
  <!-- Header -->
  <div class="max-w-6xl mx-auto px-6 pt-20 pb-12">
    <p class="font-mono text-[#2DD4BF] text-xs tracking-widest uppercase mb-4">Get in Touch</p>
    <h1 class="font-display text-5xl md:text-6xl text-white leading-tight">Contact</h1>
  </div>

  <!-- Two-column body -->
  <div class="max-w-6xl mx-auto px-6 pb-24 grid md:grid-cols-[1fr_320px] gap-16 items-start">

    <!-- LEFT — Contact form -->
    <div>
      <form
        action={FORMSPREE_ENDPOINT}
        method="POST"
        class="space-y-5"
        novalidate
      >
        <!-- Honeypot for spam prevention -->
        <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block font-mono text-xs text-white/40 tracking-widest uppercase mb-2">
              Name
            </label>
            <input
              id="name"
              type="text"
              name="name"
              required
              autocomplete="name"
              placeholder="Your name"
              class="
                w-full bg-white/[0.04] border border-white/10 rounded
                font-sans text-sm text-white placeholder-white/20
                px-4 py-3
                focus:outline-none focus:border-[#2DD4BF]/50 focus:bg-white/[0.06]
                transition-colors duration-200
              "
            />
          </div>
          <div>
            <label for="email" class="block font-mono text-xs text-white/40 tracking-widest uppercase mb-2">
              Email
            </label>
            <input
              id="email"
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="
                w-full bg-white/[0.04] border border-white/10 rounded
                font-sans text-sm text-white placeholder-white/20
                px-4 py-3
                focus:outline-none focus:border-[#2DD4BF]/50 focus:bg-white/[0.06]
                transition-colors duration-200
              "
            />
          </div>
        </div>

        <div>
          <label for="message" class="block font-mono text-xs text-white/40 tracking-widest uppercase mb-2">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            placeholder="What's on your mind?"
            class="
              w-full bg-white/[0.04] border border-white/10 rounded
              font-sans text-sm text-white placeholder-white/20
              px-4 py-3 resize-none
              focus:outline-none focus:border-[#2DD4BF]/50 focus:bg-white/[0.06]
              transition-colors duration-200
            "
          ></textarea>
        </div>

        <button
          type="submit"
          class="
            inline-flex items-center gap-2
            bg-[#2DD4BF] text-[#0D1117]
            font-sans font-semibold text-sm tracking-wide
            px-6 py-3 rounded
            hover:bg-[#2DD4BF]/90 transition-colors duration-200
            focus:outline-none focus:ring-2 focus:ring-[#2DD4BF]/50 focus:ring-offset-2 focus:ring-offset-[#0D1117]
          "
        >
          Send Message
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
          </svg>
        </button>
      </form>
    </div>

    <!-- RIGHT — Links -->
    <div>
      <p class="font-mono text-[#2DD4BF] text-xs tracking-widest uppercase mb-6">Find Me</p>
      <ul class="space-y-4">
        {links.map(({ label, href, description, icon }) => (
          <li>
            <a
              href={href}
              target={href.startsWith('mailto') ? undefined : '_blank'}
              rel={href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
              class="group flex items-center gap-4 border border-white/10 rounded-lg px-5 py-4 hover:border-[#2DD4BF]/30 hover:bg-white/[0.02] transition-colors duration-200"
            >
              <span class="w-5 h-5 shrink-0 text-white/30 group-hover:text-[#2DD4BF] transition-colors duration-200" set:html={icon} />
              <div class="min-w-0">
                <p class="font-sans font-medium text-white text-sm group-hover:text-[#2DD4BF] transition-colors duration-200">
                  {label}
                </p>
                <p class="font-mono text-xs text-white/30 truncate mt-0.5">{description}</p>
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5 shrink-0 text-white/15 group-hover:text-[#2DD4BF]/50 ml-auto transition-colors duration-200"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
