---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';

const filters = ['All', 'Machine Learning', 'Causal Inference', 'Data Engineering', 'Apps'];

const projects = [
  {
    href: '/projects/nba-model',
    title: 'NBA Betting Model',
    category: 'Machine Learning',
    description:
      'Hybrid team + player LightGBM pipeline predicting NBA moneylines, spreads and totals, with point-in-time features and walk-forward evaluation against the market. Runs daily in-season behind a live dashboard.',
    tools: ['Python', 'LightGBM', 'FLAML', 'SQLite', 'Streamlit'],
    metric: '8000+ games backtested',
    metricSublabel: '+0.26–0.42 pts closing line value on totals',
  },

  {
    href: '/projects/tennis-model',
    title: 'Tennis Prediction System',
    category: 'Machine Learning',
    description:
      'Calibrated win, total-games and spread models for ATP, Challenger and WTA matches, with leakage-proof features, Monte Carlo bracket simulation and a nightly pipeline.',
    tools: ['Python', 'LightGBM', 'SQLite', 'Streamlit', 'GitHub Actions'],
    metric: '66.4% accuracy',
    metricSublabel: '127,132 ATP matches, walk-forward',
  },

  {
    href: '/projects/translation-flashcards',
    title: 'Japanese SRS Translator',
    category: 'Apps',
    description:
      'Context-aware English-to-Japanese translation with LLMs that feeds into an SM-2 spaced-repetition deck. Runs entirely in the browser as an offline-capable PWA.',
    tools: ['TypeScript', 'React', 'LLM APIs', 'PWA'],
    metric: 'Shipped & in daily use',
    metricSublabel: '3 LLM providers with automatic fallback',
  },

  {
    href: '/projects/running-start',
    title: 'Dual-Enrollment Impact Analysis',
    category: 'Causal Inference',
    description:
      'Causal inference on linked K-12 and postsecondary administrative data. Propensity score matching and Bayesian hierarchical models address selection bias.',
    tools: ['R', 'brms', 'Stan', 'ggplot2'],
    metric: 'Bayesian causal inference',
    metricSublabel: 'Propensity matching + hierarchical models',
  },

  {
    href: '/projects/sp500',
    title: 'SP500 vs. Stock Picker',
    category: 'Machine Learning',
    description:
      'Backtesting framework that quantifies the long-term cost of active stock picking versus passive S&P 500 index investing using historical return data. Monte Carlo simulation surfaces the full distribution of outcomes.',
    tools: ['Python', 'pandas', 'yfinance', 'Plotly'],
    metric: 'Monte Carlo simulation',
    metricSublabel: 'Passive vs. active returns distribution'
  },

  {
    href: '/projects/nba-nlsql',
    title: 'NL-to-SQL NBA Query Tool',
    category: 'Data Engineering',
    description:
      'LLM-powered interface that translates plain-English basketball questions into SQL queries against an NBA stats database. Demonstrates schema context injection, prompt engineering, and a query validation layer.',
    tools: ['Python', 'OpenAI API', 'SQLite', 'Streamlit'],
    metric: 'Functional prototype',
    metricSublabel: 'Natural language to validated SQL queries'
  }

];
---

<BaseLayout
  title="Projects | Jordan Nishimura"
  description="ML, causal inference, and data engineering projects by Jordan Nishimura — NBA prediction models, impact analyses, and deployed tools."
>
  <!-- Page header -->
  <div class="max-w-6xl mx-auto px-6 pt-20 pb-10">
    <p class="font-mono text-[#2DD4BF] text-xs tracking-widest uppercase mb-4">Work</p>
    <h1 class="font-display text-5xl md:text-6xl text-white mb-4 leading-tight">Projects</h1>
    <p class="font-sans text-white/50 text-base max-w-xl leading-relaxed">
      End-to-end projects spanning predictive modeling, causal inference, and AI engineering.
      Each case study documents methodology, tradeoffs, and quantified results.
    </p>
  </div>

  <!-- Filter row (static labels) -->
  <div class="max-w-6xl mx-auto px-6 pb-12">
    <div class="flex flex-wrap gap-2" role="list" aria-label="Project categories">
      {filters.map((f, i) => (
        <span
          role="listitem"
          class:list={[
            'font-mono text-xs tracking-wide px-3.5 py-1.5 rounded border transition-colors duration-200 cursor-default select-none',
            i === 0
              ? 'border-[#2DD4BF]/50 text-[#2DD4BF] bg-[#2DD4BF]/5'
              : 'border-white/10 text-white/35 hover:text-white/60 hover:border-white/20',
          ]}
        >
          {f}
        </span>
      ))}
    </div>
  </div>

  <!-- Project grid -->
  <div class="max-w-6xl mx-auto px-6 pb-24">
    <div class="grid md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </div>
</BaseLayout>
